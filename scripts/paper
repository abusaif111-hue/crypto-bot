#!/usr/bin/env bash
# Short form of "bot paper ..." for the server console. Works as root or as the bot user;
# always runs as the bot user, never as root. Installed to /usr/local/bin/paper by
# scripts/install_paper_service.sh.
#
#   paper status
#   paper resume --operator Sultan --reason "start paper trading"
#   paper trade  --operator Sultan --reason "..." --entry 82000 --stop 80000 --target 87000 --hours 72
#   paper block  --operator Sultan --reason "..."
#   paper log [lines]          # the service log (default 30 lines)
set -euo pipefail
BOT_USER=bot

if [[ "${1:-}" == "log" ]]; then
  exec journalctl -u bot-paper -n "${2:-30}" --no-pager
fi
if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '6,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

run='cd "$HOME/crypto-bot" && exec .venv/bin/bot paper "$@"'
if [[ "$(id -un)" == "$BOT_USER" ]]; then
  exec bash -c "$run" paper "$@"
fi
exec sudo -u "$BOT_USER" -H bash -c "$run" paper "$@"
