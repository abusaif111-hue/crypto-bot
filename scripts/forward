#!/usr/bin/env bash
# Short form of "bot forward ..." for the server console. Works as root or as the bot user;
# always runs as the bot user, never as root. Installed to /usr/local/bin/forward by
# scripts/install_forward_service.sh (for "forward start", use the full path the first time).
#
#   forward status
#   forward start  --operator Sultan --confirm "I am starting the H2b forward test"
#   forward resume --operator Sultan --reason "start the H2b forward test"
#   forward block  --operator Sultan --reason "..."
#   forward log [lines]        # the service log (default 30 lines)
set -euo pipefail
BOT_USER=bot

if [[ "${1:-}" == "log" ]]; then
  exec journalctl -u bot-forward -n "${2:-30}" --no-pager
fi
if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '6,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

run='cd "$HOME/crypto-bot" && exec .venv/bin/bot forward "$@"'
if [[ "$(id -un)" == "$BOT_USER" ]]; then
  exec bash -c "$run" forward "$@"
fi
exec sudo -u "$BOT_USER" -H bash -c "$run" forward "$@"
