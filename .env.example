# Copy to .env on the bot's own machine and fill in there. Never commit .env,
# never paste keys into chat or email. Module 2 reads the two BINANCE_ values.

# Binance API key (module 2+). Start with a READ-ONLY key: trading, withdrawals
# and transfers OFF, restricted to this machine's IP address. Ed25519 key pair;
# the private key file must live OUTSIDE the repository (the bot refuses otherwise).
# Leave BINANCE_API_KEY empty for public market data only.
BINANCE_API_KEY=
BINANCE_PRIVATE_KEY_PATH=/etc/crypto-bot/ed25519_private.pem

# Live trading stays off unless this matches the exact phrase in
# src/bot/core/config.py AND config has environment: live, live_trading: true.
BOT_LIVE_CONFIRM=

# Telegram alerts (module 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
