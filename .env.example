# Copy to .env on the bot's own machine and fill in there. Never commit .env,
# never paste keys into chat or email. scripts/make_binance_key.sh fills the Binance lines.

# Binance API key (module 2+). Start with a READ-ONLY key: trading, withdrawals
# and transfers OFF, restricted to this machine's IP address.
BINANCE_API_KEY=
BINANCE_PRIVATE_KEY_PATH=/etc/crypto-bot/ed25519_private.pem

# Binance SPOT TESTNET trading key (module 5; testnet.binance.vision, fake money only). A separate
# Ed25519 key with trading enabled; never the live key above.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_PRIVATE_KEY_PATH=/etc/crypto-bot/testnet_ed25519_private.pem

# Live trading stays off unless this matches the exact phrase in
# src/bot/core/config.py AND config has environment: live, live_trading: true.
BOT_LIVE_CONFIRM=

# Telegram alerts (module 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
